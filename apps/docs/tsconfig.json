{
  // The options of @docusaurus/tsconfig 3.10, inlined without its baseUrl: baseUrl is deprecated
  // since TypeScript 6 (removed in 7), and unsetting an inherited one ("baseUrl": null) breaks
  // Playwright's tsconfig loader. paths resolve relative to this file without it.
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "module": "esnext",
    "noEmit": true,
    "paths": { "@site/*": ["./*"] },
    "skipLibCheck": true,
    "strict": true,
    "types": [
      "node",
      "@docusaurus/module-type-aliases",
      "@docusaurus/theme-classic",
      "@relvista/docusaurus-plugin/client"
    ]
  },
  "include": [
    "src",
    "docusaurus.config.ts",
    "sidebars.ts",
    "sidebars-api.ts",
    "playwright.config.ts",
    "e2e"
  ],
  "exclude": [".docusaurus", "build"]
}
