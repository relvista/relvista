{
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    // @docusaurus/tsconfig sets baseUrl, deprecated since TypeScript 6 (removed in 7): unset it
    // and give the @site alias a path relative to this file instead.
    "baseUrl": null,
    "paths": { "@site/*": ["./*"] },
    "strict": true,
    "types": [
      "node",
      "@docusaurus/module-type-aliases",
      "@docusaurus/theme-classic",
      "@relvista/docusaurus-plugin/client"
    ]
  },
  "include": [
    "src",
    "docusaurus.config.ts",
    "sidebars.ts",
    "sidebars-api.ts",
    "playwright.config.ts",
    "e2e"
  ],
  "exclude": [".docusaurus", "build"]
}
