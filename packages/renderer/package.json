{
  "name": "@relvista/renderer",
  "version": "1.1.0",
  "description": "React SVG renderer, interactive viewer and export for relvista DBML diagrams",
  "keywords": [
    "dbml",
    "erd",
    "er-diagram",
    "entity-relationship",
    "database",
    "schema",
    "diagram",
    "react",
    "svg",
    "react-flow"
  ],
  "homepage": "https://relvista.org/docs/reference",
  "bugs": {
    "url": "https://github.com/relvista/relvista/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/relvista/relvista.git",
    "directory": "packages/renderer"
  },
  "license": "MIT AND OFL-1.1 AND Apache-2.0",
  "author": "relvista contributors",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": {
      "types": "./dist/styles.css.d.ts",
      "default": "./dist/styles.css"
    },
    "./xyflow.css": {
      "types": "./dist/xyflow.css.d.ts",
      "default": "./dist/xyflow.css"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node scripts/copy-css.mjs && node scripts/copy-font-licenses.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@relvista/core": "workspace:*",
    "@xyflow/react": "13.0.3",
    "jspdf": "4.2.1",
    "svg2pdf.js": "2.9.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^31",
    "pdfjs-dist": "^6.5.438",
    "react": "^19",
    "react-dom": "^19",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1"
  }
}
